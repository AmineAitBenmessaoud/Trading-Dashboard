# Trading Dashboard - Environment Configuration
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit actual .env file to version control

# ============================================
# JWT Configuration (REQUIRED)
# ============================================
# Secret key for JWT token signing and validation
# Generate a strong random string at least 256 bits:
# Use: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-in-production-minimum-256-bits

# ============================================
# Market Data API Configuration (Optional)
# ============================================
# AlphaVantage API key for stock market data
# Get your free key at: https://www.alphavantage.co/
MARKET_API_KEY=YOUR_ALPHAVANTAGE_API_KEY

# Market data refresh interval in milliseconds
# Default: 300000 (5 minutes) - Adjust based on API call limits
MARKET_SCHEDULER_REFRESH_INTERVAL=300000

# ============================================
# Database Configuration (Docker)
# ============================================
# PostgreSQL connection details - for docker-compose
# Default: trading_auth database, user: postgres
POSTGRES_PASSWORD=postgres

# ============================================
# Spring Profiles
# ============================================
# Profile to activate: 'docker' for containerized, 'dev' for local development
SPRING_PROFILES_ACTIVE=docker

# ============================================
# Java JVM Options
# ============================================
# Heap memory configuration for each service
# -Xmx512m = Maximum heap size (512 MB)
# -Xms256m = Initial heap size (256 MB)
# Adjust based on available resources
JAVA_OPTS=-Xmx512m -Xms256m

# ============================================
# Port Configuration
# ============================================
# Gateway port (main API entry point)
GATEWAY_PORT=8080

# ============================================
# Development URLs (for local testing)
# ============================================
# These are used when running services locally (non-Docker)
AUTH_SERVICE_URL=http://localhost:8081
MARKET_SERVICE_URL=http://localhost:8082
WATCHLIST_SERVICE_URL=http://localhost:8083

# ============================================
# Docker Network Configuration
# ============================================
# Internal service URLs (used inside Docker containers)
# These should not be modified unless you change docker-compose network setup
# auth-service:8081
# market-service:8082
# watchlist-service:8083
# postgres:5432
# redis:6379
# kafka:29092

